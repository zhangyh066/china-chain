# 虚拟环境（含本机路径等环境信息，不入库）
.venv/

# Python 缓存
__pycache__/
*.py[cod]

# 构建产物（build_dist.py 可重新生成）
dist/

# 旧版备份与临时文件
_bak*
_tmp_cache.py

# 页面验证截图与中间产物（测试脚本本身入库，CI 要用）
_verify/*
!_verify/*.mjs

# 公司介绍的抓取缓存（可由 data/p/ 直接重建，不必入库）
pipeline/real/profiles/

# 日线历史的抓取缓存（可由 data/h/ 直接重建，不必入库）
pipeline/real/hist/
pipeline/real/hist_failed.json

# 全历史日线的抓取缓存（C&F 月度复刻用，fetch_history_full.py 可重建，不必入库）
pipeline/real/hist_full/
pipeline/real/hist_full_failed.json

# 供应链原始数据集（CNRDS/DataSeed，许可限制：仅限本机使用，绝不入库、绝不外传）
新建文件夹/

# 系统/编辑器杂项
.DS_Store
Thumbs.db
